{
    "name": "monitaroo/monitaroo-laravel",
    "description": "Official Monitaroo SDK for Laravel - Logs, Metrics & Monitoring",
    "keywords": ["monitaroo", "laravel", "logging", "metrics", "monitoring", "observability"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/Monitaroo/monitaroo-laravel",
    "authors": [
        {
            "name": "Monitaroo",
            "email": "support@monitaroo.com",
            "homepage": "https://monitaroo.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "monitaroo/monitaroo": "^1.0 || ^2.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/log": "^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Monitaroo\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monitaroo\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Monitaroo\\Laravel\\MonitarooServiceProvider"
            ],
            "aliases": {
                "Monitaroo": "Monitaroo\\Laravel\\Facades\\Monitaroo"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
